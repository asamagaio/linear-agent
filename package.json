{
  "name": "linear-agent",
  "version": "1.0.0",
  "description": "CLI that lets a coding agent read and write Linear issues under its own app identity",
  "type": "module",
  "bin": {
    "linear-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "claude-md.config.example",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test --test-concurrency=1 test/*.test.mjs",
    "setup": "bash scripts/bootstrap.sh",
    "claude-md:check": "bash scripts/check-claude-md.sh"
  },
  "dependencies": {
    "@linear/sdk": "^89.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asamagaio/linear-agent.git"
  },
  "homepage": "https://github.com/asamagaio/linear-agent#readme",
  "keywords": [
    "linear",
    "cli",
    "agent",
    "claude-code",
    "oauth",
    "app-actor"
  ]
}
